# Normalise to LF in the repository; check out native on Windows.
* text=auto

*.rs   text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.css  text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.sh   text eol=lf
Dockerfile text eol=lf

*.svg  text eol=lf
*.png  binary
*.jpg  binary
*.webp binary

# Lockfiles are generated: collapse them in diffs and reviews.
backend/Cargo.lock      linguist-generated=true
frontend/package-lock.json linguist-generated=true
